{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aeronjl/fipha/schemas/publication-manifest-attestation-v1.schema.json",
  "title": "fipha publication manifest attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_sha256",
    "project_sha256",
    "signer_identity",
    "signed_at_utc",
    "namespace",
    "signature_method",
    "artifact_type",
    "schema_version"
  ],
  "properties": {
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "project_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signer_identity": {"type": "string", "minLength": 1, "pattern": "^\\S+$"},
    "signed_at_utc": {"type": "string", "format": "date-time"},
    "namespace": {"const": "fipha-publication@aeronjl.github.io"},
    "signature_method": {"const": "openssh"},
    "artifact_type": {"const": "publication_manifest_attestation"},
    "schema_version": {"const": "1"}
  }
}
