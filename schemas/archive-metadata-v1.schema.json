{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aeronjl/fiberphotometry/schemas/archive-metadata-v1.schema.json",
  "title": "FiberPhotometry archive metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "creators", "publication_date", "publisher", "license", "keywords", "related_identifiers", "resource_type", "language", "artifact_type", "schema_version"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "creators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "affiliation", "orcid"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "affiliation": {"type": ["string", "null"], "minLength": 1},
          "orcid": {"type": ["string", "null"], "pattern": "^(https://orcid.org/)?[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9X]{4}$"}
        }
      }
    },
    "publication_date": {"type": "string", "format": "date"},
    "publisher": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "keywords": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "related_identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "relation"],
        "properties": {
          "identifier": {"type": "string", "minLength": 1},
          "relation": {"enum": ["Cites", "IsCitedBy", "IsDerivedFrom", "IsSupplementTo", "References"]}
        }
      }
    },
    "resource_type": {"enum": ["Dataset", "Software"]},
    "language": {"type": "string", "minLength": 2},
    "artifact_type": {"const": "fiberphotometry_archive_metadata"},
    "schema_version": {"const": "1"}
  }
}
